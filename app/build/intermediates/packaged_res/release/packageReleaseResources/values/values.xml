<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="bg_light">#F4F6FA</color>
    <color name="black">#000000</color>
    <color name="brand_accent">#00BFA5</color>
    <color name="brand_accent_dark">#00897B</color>
    <color name="brand_primary">#0D47A1</color>
    <color name="brand_primary_dark">#082F6B</color>
    <color name="brand_primary_light">#5472D3</color>
    <color name="divider">#E5E7EB</color>
    <color name="drawer_selected">#E3EBFD</color>
    <color name="status_active">#10B981</color>
    <color name="status_done">#10B981</color>
    <color name="status_isolir">#EF4444</color>
    <color name="status_new">#F59E0B</color>
    <color name="status_paid">#10B981</color>
    <color name="status_pending">#F59E0B</color>
    <color name="status_process">#3B82F6</color>
    <color name="status_unpaid">#EF4444</color>
    <color name="surface_white">#FFFFFF</color>
    <color name="text_primary">#1A1D29</color>
    <color name="text_secondary">#6B7280</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">ISP Management</string>
    <string name="close_drawer">Tutup menu</string>
    <string name="open_drawer">Buka menu</string>
    <style name="RoundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Theme.IspManagement" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
    </style>
    <style name="Theme.IspManagement.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Theme.IspManagement.Button.Accent" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_accent</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.IspManagement.Card">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/surface_white</item>
    </style>
    <style name="Theme.IspManagement.InputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
    </style>
</resources>