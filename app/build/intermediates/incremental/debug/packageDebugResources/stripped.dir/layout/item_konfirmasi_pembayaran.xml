<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIdKonfirmasi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Konfirmasi #7" />

            <TextView
                android:id="@+id/tvStatusKonfirmasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Pending" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCaraBayarKonfirmasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Transfer ATM" />

        <TextView
            android:id="@+id/tvTanggalKonfirmasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Dibayar: 2 Juli 2026" />

        <ImageView
            android:id="@+id/ivBuktiTransfer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="#F3F4F6"
            tools:visibility="visible" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLihatDetail"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Lihat Detail Pembayaran"
            app:icon="@android:drawable/ic_menu_view" />

        <LinearLayout
            android:id="@+id/layoutAksiKonfirmasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTerima"
                style="@style/Theme.IspManagement.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="✓ Terima" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTolak"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="@color/status_unpaid"
                android:text="✗ Tolak"
                android:textAllCaps="false"
                android:textColor="@color/white"
                style="@style/Theme.IspManagement.Button" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCatatanTolak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/status_unpaid"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Ditolak: Bukti tidak jelas" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
